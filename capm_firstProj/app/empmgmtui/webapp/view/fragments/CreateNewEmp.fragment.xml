<core:FragmentDefinition xmlns:unified="sap.ui.unified"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
    xmlns:table="sap.ui.table"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:upload="sap.m.upload">
    <Dialog title="Create Employee" contentHeight="80%" contentWidth="80%">
        <f:SimpleForm editable="true" labelSpanL="3" labelSpanM="3" emptySpanL="3" emptySpanM="3">
            <f:content>
                <Label text="Name"/>
                <Input value="{name}"/>
                <Label text="Designation"/>
                <Input value="{desig_code}"/>
                <Label text="Skill"/>
                <Input value="{skill_code}"/>
                <Label text="Email"/>
                <Input value="{email}"/>
                <Label text="Salary"/>
                <Input value="{salary}"/>
                <Label text="Rating"/>
                <Input value="{rating}"/>
                <Label text="Status"/>
                <Input value="{status}"/>
                <Label text="Upload Photo"/>
                <unified:FileUploader id="FileUploader" sendXHR="true" useMultipart="false" httpRequestMethod="Put"></unified:FileUploader>
            </f:content>
        </f:SimpleForm>
        <Table items="{projects}" id="PrjTab">
            <headerToolbar>
                <Toolbar >
                    <Title text="Projects"></Title>
                    <ToolbarSpacer></ToolbarSpacer>
                    <Button icon="sap-icon://add" text="Add Pproject" press="onAddProject"/>
                </Toolbar>
            </headerToolbar>
            <columns>
                <Column >
                    <Text text="Project Name"></Text>
                </Column>
                <Column >
                    <Text text="Client Name"></Text>
                </Column>
            </columns>
            <items>
                <ColumnListItem >
                    <Input value="{prjname}"></Input>
                    <Input value="{client}"></Input>
                </ColumnListItem>
            </items>
        </Table>
        <upload:UploadSet id="UploadSet" items="{docs}" instantUpload="false" multiple="true" httpRequestMethod="Put" afterItemAdded="onAfterItemAdded">
            <upload:items>
                <upload:UploadSetItem fileName="{fileName}" mediaType="{fileType}"/>
            </upload:items> 
        </upload:UploadSet>
        <beginButton>
            <Button text="Save" type="Emphasized" press="onPressSave"></Button>
        </beginButton>
        <endButton>
            <Button text="Cancel" type="Reject" press="onPressCancel"></Button>
        </endButton>
    </Dialog>
</core:FragmentDefinition>