<mvc:View xmlns:mdc="sap.ui.mdc"
    xmlns:table="sap.ui.table" controllerName="com.demo.empmgmtui.controller.View2"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form">
    <Page title="Employee Data">
        <content>
            <ObjectHeader icon="/odata/v4/emp-mgmt/EmployeeSet({ID})/photo" title="{name}" number="{salary}" iconActive="true" iconPress="onDownload">
                <attributes>
                    <ObjectAttribute title="ID" text="{ID}"></ObjectAttribute>
                    <ObjectAttribute title="Designation" text="{desig_code}"></ObjectAttribute>
                </attributes>
                <statuses>
                    <ObjectStatus text="{status}"></ObjectStatus>
                </statuses>
            </ObjectHeader>
            <IconTabBar >
                <items>
                    <IconTabFilter icon="sap-icon://information">
                        <f:SimpleForm>
                            <f:content>
                                <Label text="Employee ID"/>
                                <Text text="{ID}"/>
                                <Label text="Name"/>
                                <Text text="{name}"/>
                                <Label text="Designation"/>
                                <Text text="{desig_code}"/>
                                <Label text="Skill"/>
                                <Text text="{skill_code}"/>
                                <Label text="Email"/>
                                <Text text="{email}"/>
                                <Label text="Salary"/>
                                <Text text="{salary}"/>
                                <Label text="Status"/>
                                <Text text="{status}"/>
                            </f:content>
                        </f:SimpleForm>
                    </IconTabFilter>
                    <IconTabFilter icon="sap-icon://capital-projects">
                        <Table items="{projects}">
                            <columns>
                                <Column >
                                    <Text text="Employee ID"></Text>
                                </Column>
                                <Column >
                                    <Text text="Project ID"></Text>
                                </Column>
                                <Column >
                                    <Text text="Project Name"></Text>
                                </Column>
                                <Column >
                                    <Text text="Client"></Text>
                                </Column>
                            </columns>
                            <items>
                                <ColumnListItem>
                                    <Text text="{emp_ID}"></Text>
                                    <Text text="{ID}"></Text>
                                    <Text text="{prjname}"></Text>
                                    <Text text="{client}"></Text>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </IconTabFilter>
                </items>
            </IconTabBar>
        </content>
    </Page>
</mvc:View>