<mvc:View xmlns:mdc="sap.ui.mdc"
    xmlns:table="sap.ui.table" controllerName="com.demo.empmgmtui.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page id="page" title="{i18n>title}">
        <content>
            <Table id="EmpTab" items="{/EmployeeSet}" class="sapUiSmallMargin" width="auto">
                <headerToolbar>
                    <Toolbar>
                        <Title text="Employee Table"></Title>
                        <ToolbarSpacer ></ToolbarSpacer>
                        <!-- <SearchField id="SF" width="30%" liveChange="onSearch"></SearchField> -->
                        <Button text="Create New Employee" type="Emphasized" icon="sap-icon://add" press="onCreateEmpOpen"></Button>
                    </Toolbar>
                </headerToolbar>
                <columns>
                    <Column >
                        <Text text="Employee ID"></Text>
                    </Column>
                    <Column >
                        <Text text="Name"></Text>
                    </Column>
                    <Column >
                        <Text text="Designation"></Text>
                    </Column>
                    <Column >
                        <Text text="Skill"></Text>
                    </Column>
                    <Column >
                        <Text text="Email"></Text>
                    </Column>
                </columns>
                <items>
                    <ColumnListItem type="Active" press="onPressRow">
                        <Text text="{ID}"></Text>
                        <Text text="{name}"></Text>
                        <Text text="{desig_code}"></Text>
                        <Text text="{skill_code}"></Text>
                        <Text text="{email}"></Text>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
    </Page>
</mvc:View>